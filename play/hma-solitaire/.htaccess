# Apache only; other servers ignore this file.
# Compress the game and make browsers check for updates, so new versions show up right away.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|jpg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
