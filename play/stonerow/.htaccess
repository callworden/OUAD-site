# StoneRow 1.0 — optional Apache settings for this folder.
# Every block is wrapped in <IfModule>, so a host without a given module simply skips it.

DirectoryIndex index.html
AddDefaultCharset UTF-8
Options -Indexes

# Compress text files: the game page shrinks noticeably on the way to the browser.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Caching: always check for a newer index.html (so updates show up right away),
# but let browsers keep the icons and preview image for a month.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
