<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop - Once Upon A Dice</title>
    <link rel="stylesheet" href="styles/main.css">
    <link rel="stylesheet" href="styles/shop.css">
    <link rel="stylesheet" href="styles/rebrand.css">
</head>
<body>
    <!-- Navigation -->
    <nav class="main-nav">
        <div class="nav-container">
            <a href="/" class="logo">
                <img src="images/misc/logo.png" alt="Once Upon A Dice" class="logo-image">
            </a>
            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/games.html">Games</a>
                <a href="/shop.html" class="active">Shop</a>
                <a href="/events.html">Events</a>
                <a href="/news.html">News</a>
                <a href="/about.html">About</a>
                <a href="/contact.html">Contact</a>
            </div>
        </div>
    </nav>

    <!-- Header -->
    <section class="page-header">
        <div class="header-content">
            <h1>Our Games</h1>
            <p>Available now through DriveThruCards. Physical card games shipped to your door, or grab digital print-and-play files for instant play.</p>
            <div class="shop-powered-by">
                <span>🛒 Powered by DriveThruCards</span>
            </div>
        </div>
    </section>

    <!-- Products -->
    <section class="shop-section">
        <div class="shop-grid">

            <!-- Her Majesty's Airships -->
            <div class="product-card">
                <div class="product-image">
                    <img src="images/games/her-majesty-airship-card.jpg" alt="Her Majesty's Airships">
                    <div class="product-badge available">Available</div>
                </div>
                <div class="product-info">
                    <p class="product-subtitle">The Aerosphere — Cooperative Card Game</p>
                    <h3>Her Majesty's Airships</h3>
                    <p class="product-description">A steampunk cooperative card game of sabotage, strategy, and survival aboard a royal airship.</p>
                    <div class="product-meta">
                        <span class="meta-item">👥 2-4 Players</span>
                        <span class="meta-item">⏱️ 30-45 min</span>
                        <span class="meta-item">🤝 Co-op</span>
                    </div>
                    <a href="https://www.drivethrucards.com/en/product/429835/her-majesty-s-airships-the-aerosphere"
                       target="_blank" rel="noopener" class="btn btn-primary dtc-btn">
                        Buy on DriveThruCards →
                    </a>
                </div>
            </div>

            <!-- StoneRow -->
            <div class="product-card">
                <div class="product-image">
                    <img src="images/games/stonerow-white-card.jpg" alt="StoneRow: Grinding Gears Edition">
                    <div class="product-badge available">Available</div>
                </div>
                <div class="product-info">
                    <p class="product-subtitle">Grinding Gears Edition — Strategy Card Game</p>
                    <h3>StoneRow</h3>
                    <p class="product-description">A medieval tower-building card game of guild rivalry. Simple rules, deep strategy, four unique guilds.</p>
                    <div class="product-meta">
                        <span class="meta-item">👥 2 Players</span>
                        <span class="meta-item">⏱️ 15-20 min</span>
                        <span class="meta-item">⚔️ Strategy</span>
                    </div>
                    <a href="https://www.drivethrucards.com/en/product/270284/stonerow-grinding-gears-edition"
                       target="_blank" rel="noopener" class="btn btn-primary dtc-btn">
                        Buy on DriveThruCards →
                    </a>
                </div>
            </div>

            <!-- Bounce Bunny Bounce -->
            <div class="product-card">
                <div class="product-image">
                    <img src="images/games/bounce-bunny-card.jpg" alt="Bounce Bunny Bounce">
                    <div class="product-badge available">Available</div>
                </div>
                <div class="product-info">
                    <p class="product-subtitle">Family Party Card Game</p>
                    <h3>Bounce Bunny Bounce</h3>
                    <p class="product-description">Fast, fun, and chaotic. A family-friendly party game that's easy to learn and impossible to put down.</p>
                    <div class="product-meta">
                        <span class="meta-item">👥 3-6 Players</span>
                        <span class="meta-item">⏱️ 20-25 min</span>
                        <span class="meta-item">🎯 Ages 8+</span>
                    </div>
                    <a href="https://www.drivethrucards.com/en/product/336921/bounce-bunny-bounce"
                       target="_blank" rel="noopener" class="btn btn-primary dtc-btn">
                        Buy on DriveThruCards →
                    </a>
                </div>
            </div>

        </div>
    </section>

    <!-- Other Ways to Find Us -->
    <section class="shop-info">
        <div class="info-content">
            <h2>Other Ways to Find Us</h2>
            <div class="info-grid info-grid--single">

                <div class="info-card">
                    <div class="info-card-icon">📦</div>
                    <h3>Convention Sales</h3>
                    <p>Catch us at local conventions and game expos for in-person demos and purchases. Check our <a href="/events.html">events page</a> for upcoming appearances.</p>
                </div>

            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="footer-content">
            <p>&copy; 2026 Once Upon A Dice. Built on Alma + Nginx.</p>
            <div class="footer-links">
                <a href="/shop.html">Store</a>
                <a href="/contact.html">Contact</a>
                <a href="/press.html">Press Kit</a>
            </div>
        </div>
    </footer>

    <style>
        .shop-powered-by {
            margin-top: 0.85rem;
            font-size: 0.8rem;
            color: rgba(255,255,255,0.35);
            letter-spacing: 0.05em;
        }
        .product-subtitle {
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.35);
            margin-bottom: 0.3rem;
        }
        .dtc-btn {
            display: block;
            width: 100%;
            text-align: center;
            margin-top: var(--spacing-md);
        }
        .info-card-icon {
            font-size: 2rem;
            margin-bottom: var(--spacing-sm);
        }
        /* Single card centred */
        .info-grid--single {
            max-width: 480px;
            margin: 0 auto;
            grid-template-columns: 1fr;
        }
    </style>

    <script src="scripts/main.js"></script>
</body>
</html>
